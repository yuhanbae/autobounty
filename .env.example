# AutoBounty Environment Variables
# Copy to .env and fill in your values
# NEVER commit this file!

# === Required: LLM Providers ===
AGNES_API_KEY=atr_...
NVIDIA_API_KEY=ghu_...

# === Required: Telegram Bot ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=  # Optional: auto-captured from first bot message

# === Platform Tokens ===
# Railway (for railway up)
RAILWAY_TOKEN=b4086c42-125e-4b0a-9d66-dfe5a3ef319f

# Fly.io (flyctl deploy)
# FLY_API_TOKEN=fly_...

# GitHub (for Actions secrets & git push)
# GITHUB_TOKEN=ghp_...

# === Optional ===
# LOCAL_LLM_URL=http://127.0.0.1:8080  # For Vulkan GPU tier
# GIT_REPO_URL=https://x-access-token:${GITHUB_TOKEN}@github.com/yuhanbae/autobounty